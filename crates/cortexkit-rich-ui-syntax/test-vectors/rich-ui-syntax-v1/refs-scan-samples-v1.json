{
  "dialect": "refs-scan/v1",
  "spanUnit": "UTF-8 bytes, start inclusive, end exclusive",
  "rules": {
    "token": "A reference token is `$$tc(` + a decimal N with no leading zeros (0 itself allowed) + `)`.",
    "reply": [
      "Markdown text counts, including the content of tags, block quotes, lists and table cells.",
      "Fenced code (3 or more backticks or tildes; an unclosed fence runs to the end) never counts.",
      "Code spans never count.",
      "A backslash-escaped `\\$` breaks the token, so `\\$$tc(N)` is text.",
      "Inside a tag's open tag, only a `{...}` prop value counts, and inside it only outside string literals (double or single quoted, with the spec's escapes). A quoted prop value never counts."
    ],
    "program": [
      "The body follows the reply rules.",
      "A declaration (`export const` or `export let` at column 1, outside fenced code) counts in its expression, outside string literals."
    ],
    "token_slot": [
      "A tool argument declared as a token slot counts only when its whole value is exactly one token, with nothing before or after it."
    ],
    "unsettled": [
      "A tag candidate that fails to parse (for example one with a blank line inside its open tag) is left out of v1's samples. The language crate's scanner settles it, and runners adopt that scanner."
    ]
  },
