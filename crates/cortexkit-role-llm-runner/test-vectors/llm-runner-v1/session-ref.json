{
  "description": "session_ref: the first 16 bytes (32 lowercase hex characters) of SHA-256 over the RFC 8785 (JCS) bytes of {\"harness\",\"runner\",\"session\"}. runner is the attested principal's bare module id from session_binding.runner, never a reserved:<id> display form. The display-form case deliberately uses the wrong spelling to pin distinct bytes; the helper never strips prefixes. Every field is used exactly as given, never normalised. The pure derivation accepts any string, including empty strings; bind validation is separate.",
  "cases": [
    {
      "name": "ascii",
      "bind": {
        "runner": "runner-a",
        "harness": "harness-a",
        "session": "session-1"
      },
      "jcs": "{\"harness\":\"harness-a\",\"runner\":\"runner-a\",\"session\":\"session-1\"}",
      "session_ref": "f93ec93e3559a70a8db019b29e0fa883"
    },
    {
      "name": "principal display form is not the bare module id",
      "bind": {
        "runner": "reserved:runner-a",
        "harness": "harness-a",
        "session": "session-1"
      },
      "jcs": "{\"harness\":\"harness-a\",\"runner\":\"reserved:runner-a\",\"session\":\"session-1\"}",
      "session_ref": "e63a853a5046189355d067fb9f1a7759"
    },
    {
      "name": "same session on another runner",
      "bind": {
        "runner": "runner-b",
        "harness": "harness-a",
        "session": "session-1"
      },
      "jcs": "{\"harness\":\"harness-a\",\"runner\":\"runner-b\",\"session\":\"session-1\"}",
      "session_ref": "da978e0dd29a105853d45317fcd66408"
    },
    {
      "name": "unicode",
      "bind": {
        "runner": "実行器-é",
        "harness": "配線-λ",
        "session": "会話-🦀"
      },
      "jcs": "{\"harness\":\"配線-λ\",\"runner\":\"実行器-é\",\"session\":\"会話-🦀\"}",
      "session_ref": "5c653b2ad6efe06a59f5078e8df8a0b0"
    },
    {
      "name": "quote and backslash escaping",
      "bind": {
        "runner": "runner-\"a\"",
        "harness": "harness\\a",
        "session": "session\n\t\\\"\u0000"
      },
      "jcs": "{\"harness\":\"harness\\\\a\",\"runner\":\"runner-\\\"a\\\"\",\"session\":\"session\\n\\t\\\\\\\"\\u0000\"}",
      "session_ref": "9358ed7e5db36368618f24997e5756eb"
    },
    {
      "name": "empty fields",
      "bind": {
        "runner": "",
        "harness": "",
        "session": ""
      },
      "jcs": "{\"harness\":\"\",\"runner\":\"\",\"session\":\"\"}",
      "session_ref": "beeaccb7ec329b79e2096b4abb032ea9"
    },
    {
      "name": "whitespace is significant",
      "bind": {
        "runner": "runner-a ",
        "harness": " harness-a",
        "session": "session-1 "
      },
      "jcs": "{\"harness\":\" harness-a\",\"runner\":\"runner-a \",\"session\":\"session-1 \"}",
      "session_ref": "a5756495f96bf5737589d79fa8ca3a91"
    },
    {
      "name": "decomposed unicode",
      "bind": {
        "runner": "runner-a",
        "harness": "harness-a",
        "session": "é"
      },
      "jcs": "{\"harness\":\"harness-a\",\"runner\":\"runner-a\",\"session\":\"é\"}",
      "session_ref": "fd86a219135a67e2b5775cfa1851e2de"
    }
  ]
}
