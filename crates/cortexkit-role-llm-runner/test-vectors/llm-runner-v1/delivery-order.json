  "without_group": [
    {
      "name": "a runner without the group refuses a list naming delivery, as an older runner's strict decode does",
      "declares": [
        "queue",
        "steer"
      ],
      "request": {
        "prompt": "reminder w-1",
        "send_id": "w-1",
        "delivery": [
          "steer"
        ]
      },
      "refusal": {
        "code": "invalid_params",
        "detail": {
          "field": "delivery"
        }
      }
