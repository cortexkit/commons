    {
      "id": "stored-entry-replayed-without-model-support",
      "route": { "protocol": "anthropic_messages", "turn_system_supported": false },
      "rendered_text": "Keep the summary concise.",
      "stored_entry": {
        "role": "system",
        "text": "Keep the summary concise.",
        "delivered_as": { "mode": "turn_system" }
      },
      "attempts": [
        {
          "conversation": [
            { "role": "user", "content": "Summarize the notes." },
            { "role": "assistant", "content": "Here is the summary." }
          ],
          "insertion_index": 1,
          "expect": {
            "outcome": "replayed",
            "authority": "user",
            "delivered_as": { "mode": "turn_system" },
            "stored_entry_unchanged": true,
            "request": {
              "messages": [
                { "role": "user", "content": "Summarize the notes." },
                { "role": "user", "content": "<context-note>Keep the summary concise.</context-note>" },
                { "role": "assistant", "content": "Here is the summary." }
              ]
            }
          }
        }
      ]
