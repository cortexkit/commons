              "messages": [
                { "role": "user", "content": "Summarize the notes." },
                { "role": "assistant", "content": "Here is the summary." },
                { "role": "user", "content": "Include the action items." },
                { "role": "system", "content": "Keep the summary concise." }
              ]
            }
          }
        }
      ]
    },
