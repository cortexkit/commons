    {
      "id": "unsupported-route-falls-through-at-user-authority",
      "route": { "protocol": "gemini", "turn_system_supported": false },
      "rendered_text": "Keep the summary concise.",
      "delivery": ["turn_system", "steer"],
      "attempts": [
        {
          "conversation": [
            { "role": "user", "parts": [{ "text": "Summarize the notes." }] }
