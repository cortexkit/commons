{
  "contract": "llm-runner/v1",
  "cases": [
    {
      "id": "openai-responses-developer-in-order",
      "route": { "protocol": "openai_responses", "turn_system_supported": true },
      "rendered_text": "Keep the summary concise.",
      "delivery": ["turn_system", "steer"],
      "attempts": [
        {
          "conversation": [
            { "role": "user", "content": [{ "type": "input_text", "text": "Summarize the notes." }] }
          ],
          "insertion_index": 1,
          "expect": {
            "outcome": "delivered",
            "authority": "system",
            "delivered_as": { "mode": "turn_system" },
            "request": {
              "input": [
                { "role": "user", "content": [{ "type": "input_text", "text": "Summarize the notes." }] },
                { "role": "developer", "content": [{ "type": "input_text", "text": "Keep the summary concise." }] }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "anthropic-native-after-tool-result",
      "route": { "protocol": "anthropic_messages", "turn_system_supported": true },
      "rendered_text": "Keep the summary concise.",
      "delivery": ["turn_system"],
      "attempts": [
        {
          "conversation": [
            { "role": "assistant", "content": [{ "type": "tool_use", "id": "call_1", "name": "read_notes", "input": {} }] },
            { "role": "user", "content": [{ "type": "tool_result", "tool_use_id": "call_1", "content": "Public notes." }] }
          ],
          "insertion_index": 2,
          "expect": {
            "outcome": "delivered",
            "authority": "system",
            "delivered_as": { "mode": "turn_system" },
            "request": {
              "messages": [
                { "role": "assistant", "content": [{ "type": "tool_use", "id": "call_1", "name": "read_notes", "input": {} }] },
                { "role": "user", "content": [{ "type": "tool_result", "tool_use_id": "call_1", "content": "Public notes." }] },
                { "role": "system", "content": "Keep the summary concise." }
              ]
            }
          }
        }
      ]
    },
    {
