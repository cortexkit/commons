{
  "profile": "anthropic-messages",
  "rows": [
    {
      "name": "a string content is one text part",
      "body": {
        "role": "user",
        "content": "hello"
      },
      "row": {
        "role": "user",
        "text": "hello",
        "parts": [
          {
            "type": "text",
            "part": "0",
            "text": "hello"
          }
        ]
      }
    },
    {
      "name": "text and reasoning blocks keep their order; text joins without a separator",
      "body": {
        "role": "assistant",
        "content": [
          {
            "type": "thinking",
            "thinking": "let me think",
            "signature": "c2ln"
          },
          {
            "type": "text",
            "text": "first, "
          },
          {
            "type": "text",
            "text": "second"
          }
        ]
      },
      "row": {
        "role": "assistant",
        "text": "first, second",
        "parts": [
          {
            "type": "reasoning",
            "part": "0",
            "text": "let me think"
          },
          {
            "type": "text",
            "part": "1",
            "text": "first, "
          },
          {
            "type": "text",
            "part": "2",
            "text": "second"
          }
        ]
      }
    },
    {
