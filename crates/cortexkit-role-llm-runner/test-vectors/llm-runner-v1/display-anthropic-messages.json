            "type": "text",
            "text": "running"
          },
          {
            "type": "tool_use",
            "id": "toolu_1",
            "name": "echo",
            "input": {
              "q": "x",
              "n": [
                1,
                2
              ]
            }
          }
        ]
      },
      "row": {
        "role": "assistant",
        "text": "running",
        "parts": [
