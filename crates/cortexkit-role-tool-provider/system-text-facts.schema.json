{
  "description": "Plan-carried system-text facts. x-sorted is a CortexKit annotation ignored by standard JSON Schema validators; the Rust decoder enforces ascending UTF-8 byte order. No variant, effort, time, count or session state belongs here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "harness", "tools", "idle_start"],
  "properties": {
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "id"],
      "properties": {
        "provider": {"type": "string"},
        "id": {"type": "string"}
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "facts"],
      "properties": {
        "id": {"type": "string"},
        "facts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "x-sorted": true}
      }
    },
    "tools": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "x-sorted": true},
    "idle_start": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "x-sorted": true}
  }
}
