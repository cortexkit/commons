      "requests": [{"run_id": "r1", "at": "step_boundary"}, {"run_id": "r1", "at": "step_boundary"}],
      "answers": ["ack", "ack"],
      "terminal": {"run_id": "r1", "state": "cancelled"}
    },
    {
      "name": "now escalates a waiting boundary cancellation",
      "initial": {"run_id": "r1", "state": "active"},
      "requests": [{"run_id": "r1", "at": "step_boundary"}, {"run_id": "r1", "at": "now"}],
      "answers": ["ack", "ack"],
      "terminal": {"run_id": "r1", "state": "cancelled"}
    },
    {
      "name": "the finishing step reaches completed before cancellation seals",
