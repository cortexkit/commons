    { "name": "completed, outcome only", "body": { "answer": "completed", "outcome": "ok", "result_retained": false }, "decodes_as": "completed_outcome_only" },
    { "name": "refused, denied", "body": { "answer": "refused", "reason": "denied" }, "decodes_as": "refused" },
    { "name": "refused, expired", "body": { "answer": "refused", "reason": "expired" }, "decodes_as": "refused" },
    { "name": "refused, scope ended", "body": { "answer": "refused", "reason": "scope_ended" }, "decodes_as": "refused" },
    { "name": "refused, open reason", "body": { "answer": "refused", "reason": "vendor_hold" }, "decodes_as": "refused_other" }
  ],
  "unclassified": [
    { "name": "a future answer", "body": { "answer": "superseded" } },
