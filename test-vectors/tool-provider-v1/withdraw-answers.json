    { "name": "started without outcome", "body": { "answer": "already_started" } },
    { "name": "completed without result_retained", "body": { "answer": "completed", "result": {} } },
    { "name": "retained without result", "body": { "answer": "completed", "result_retained": true } },
    { "name": "not retained without outcome", "body": { "answer": "completed", "result_retained": false } },
