{
  "_about": "Argument schemas. A flat schema is an object with no root-level anyOf, oneOf or allOf; unions below the root are allowed.",
  "flat": [
    { "name": "empty object", "schema": { "type": "object" } },
    { "name": "properties", "schema": { "type": "object", "properties": { "path": { "type": "string" }, "limit": { "type": "integer" } }, "required": ["path"] } },
    { "name": "nested union", "schema": { "type": "object", "properties": { "target": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] } } } },
    { "name": "host-only parameter", "schema": { "type": "object", "properties": { "session_hint": { "type": "string", "x-ck-audience": "host" } } } }
  ],
  "not_flat": [
    { "name": "root anyOf", "schema": { "anyOf": [{ "type": "object", "properties": { "a": { "type": "string" } } }, { "type": "object", "properties": { "b": { "type": "string" } } }] } },
    { "name": "root oneOf", "schema": { "type": "object", "oneOf": [{ "required": ["a"] }, { "required": ["b"] }] } },
    { "name": "root allOf", "schema": { "allOf": [{ "type": "object" }] } },
    { "name": "not an object", "schema": true }
  ]
}
